{
  "metadata": {
    "name": "Motor-EPM \u00b7 COHERENT WALK \u26a1",
    "description": "The coherent-gait solution (docs/reports/picrawler_gait_loop_findings.md). Drives every joint from ONE clean entrained CPG phase (cpg_phase_topic=rhythm.cpg.body; coupling+stroke OFF) so the whole body is a single-frequency limit cycle (intra-leg period spread ~0.5 vs the trot's ~32) \u2014 which breaks the keyframe precision plateau (0.26->0.52, keyframe crystallizes). Statically-stable lateral-sequence walk phasing [pi/2,3pi/2,0,pi] + stroke_signs on the fore-aft joint give a stable, straight, ~3x-faster gait (fwd_v +0.116 vs trot +0.041) with 0-2 belly-up flips. rhythm_fade_start/end weans the scaffold (Gate 2): the keyframe HOLDS coordination but not propulsion (posture template).",
    "env_target": "picrawler",
    "phase_tag": "motor-epm (minimal/deploy)",
    "derived_from_manifest": false,
    "episode_length": 6000,
    "mc_episode_period": 1500,
    "stability_gain": 0.05,
    "stability_y_norm": 0.5,
    "stability_speed": 0.05,
    "reward_shape": "trapezoid",
    "target_height": 0.085,
    "height_penalty_grace": 0.02,
    "height_penalty_scale": 0.03,
    "height_penalty_gain": 0.05,
    "leg_symmetry": "lr_pairs",
    "label": "motor_epm_rung0",
    "publish_tilt": true,
    "tier": "nav_oracle",
    "reward_class": "internal_objective",
    "scaffolds_active": [
      "postural",
      "coupling",
      "stroke",
      "balance",
      "amp_homeostat",
      "height_homeostat",
      "panic",
      "nav_oracle"
    ]
  },
