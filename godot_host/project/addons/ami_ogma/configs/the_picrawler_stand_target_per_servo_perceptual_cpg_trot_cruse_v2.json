{
  "metadata": {
    "name": "1 \u00b7 CRUSE V2 SUBSTRATE",
    "description": "[1 \u00b7 CRUSE V2 SUBSTRATE] Canonical substrate baseline: 12 per-servo Premotors + perceptual CPG + CruseCoordinator (rules 1/2/3). NO cognitive layer. Pre-H1 substrate everything else builds on. Use with STAND-ONLY curriculum to see the historic standing fixed-point. Pair with: picrawler_stand_only_no_walk_advance_1200 OR picrawler_g6dof_stage_hand_tuned_2026_06_03.",
    "env_target": "picrawler",
    "phase_tag": "v6.17b + compass + perceptual-cpg trot (Phase 7.5 arm G2)",
    "derived_from_manifest": true,
    "episode_length": 6000,
    "mc_episode_period": 1500,
    "stability_gain": 0.05,
    "stability_y_norm": 0.5,
    "stability_speed": 0.05,
    "reward_shape": "trapezoid",
    "target_height": 0.085,
    "height_penalty_grace": 0.02,
    "height_penalty_scale": 0.03,
    "height_penalty_gain": 0.05,
    "leg_symmetry": "lr_pairs",
    "label": "cruse_v2_baseline"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
