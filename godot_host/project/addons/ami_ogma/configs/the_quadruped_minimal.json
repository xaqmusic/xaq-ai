{
  "metadata": {
    "name": "Quadruped — brain-only standing balance (v6.0.c minimal)",
    "description": "v6.0.a.6 — 8-channel motor authority. Four bilateral Premotors (one per leg: premotor_fl/fr/rl/rr), each emitting (hip, knee) torque pairs to action.{leg}_hip + action.{leg}_knee. The body has 8 actuated DOFs total, all rotating around the leg's lateral axis. Hip is no longer locked — both hip and knee are brain-controlled with weak rest PD bias toward standing pose. StaleConfidenceDecay watches chassis_height EPM winners. Reward is per-tick events.body_alive. Brain MUST actively coordinate all 8 channels to maintain standing.",
    "env_target": "quadruped",
    "phase_tag": "v6.0.a.6-8channel",
    "derived_from_manifest": true,
    "episode_length": 6000
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.97,
        "ht_decay": 0.97,
        "intrinsic_da_gain": 0.0,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001,
        "wall_stuck_da_drain": 0.0,
        "wall_stuck_ht_drain": 0.0,
        "aligned_event_name": "body_lift",
        "da_aligned_gain": 0.005
      }
    },
    {
      "id": "epm_imu",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "imu",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.imu",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_joints",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "joints",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.joints",
        "projection_dim": 32,
        "proprio_state_dims": 12,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_foot_contact",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "foot_contact",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.foot_contact",
        "projection_dim": 16,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_chassis_height",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "chassis_height",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.chassis_height",
        "projection_dim": 8,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "voter_0",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.",
        "trust_epsilon": 0.05,
        "group_balance": false,
        "priority_group": "kinematic"
      }
    },
    {
      "id": "descend",
      "type": "DescendingPredictor",
      "params": {
        "consensus_topic": "consensus.0",
        "targets": [
          "reality.kinematic.imu",
          "reality.kinematic.joints",
          "reality.kinematic.foot_contact",
          "reality.kinematic.chassis_height"
        ],
        "update_method": "sgd",
        "learning_rate": 0.005
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": ["alive"],
        "channel_kinds": ["alive_pulse"],
        "setpoints": [1.0],
        "urgency_normalizers": [1.0],
        "channel_input_topics": ["events.body_alive"],
        "alive_pulse_decay_per_tick": 0.005,
        "alive_pulse_replenish_per_event": 0.5
      }
    },
    {
      "id": "premotor_fl",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.fl_hip",
        "output_topic_right": "action.fl_knee",
        "update_alpha_threshold": 0.0, "master_seed": 100,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "aligned_event_name": "body_lift", "aligned_reward_gain": 1.0,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "premotor_fr",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.fr_hip",
        "output_topic_right": "action.fr_knee",
        "update_alpha_threshold": 0.0, "master_seed": 200,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "aligned_event_name": "body_lift", "aligned_reward_gain": 1.0,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "premotor_rl",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.rl_hip",
        "output_topic_right": "action.rl_knee",
        "update_alpha_threshold": 0.0, "master_seed": 300,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "aligned_event_name": "body_lift", "aligned_reward_gain": 1.0,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "premotor_rr",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.rr_hip",
        "output_topic_right": "action.rr_knee",
        "update_alpha_threshold": 0.0, "master_seed": 400,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "aligned_event_name": "body_lift", "aligned_reward_gain": 1.0,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "stale_decay_chassis",
      "type": "StaleConfidenceDecay",
      "params": {
        "input_topic":         "reality.kinematic.chassis_height",
        "output_topic":        "cognition.boredom",
        "idle_threshold_ticks": 60,
        "decay_window_ticks":   240,
        "publish_when_zero":    false
      }
    }
  ],
  "edges": []
}
