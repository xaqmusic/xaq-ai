{
  "metadata": {
    "name": "PiCrawler — Per-Servo + Compass + Per-Leg Hierarchical EPM (Phase 7.2-EPM arm D)",
    "description": "Phase 7.2-EPM hierarchical-EPM arm D — Pattern #2 variant.  4 per-leg EPMs (group_size=3 bridge) replacing the 12-D monolithic joints EPM.  No sub-voters — voter_0 directly fuses IMU + compass + 4 per-leg fused EPM outputs.  Structurally identical to the hierarchy already proven functional in chunks_compass_cpg.  Compare against arm C (12-per-joint + sub-voters) to answer the granularity question.",
    "env_target": "picrawler",
    "phase_tag": "v6.17b + compass + per-leg hierarchical EPM (Phase 7.2-EPM arm D)",
    "derived_from_manifest": true,
    "episode_length": 6000,
    "mc_episode_period": 1500,
    "stability_gain": 0.05,
    "stability_y_norm": 0.5,
    "stability_speed": 0.05,
    "reward_shape": "trapezoid",
    "target_height": 0.085,
    "height_penalty_grace": 0.02,
    "height_penalty_scale": 0.03,
    "height_penalty_gain": 0.05,
    "leg_symmetry": "lr_pairs"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
