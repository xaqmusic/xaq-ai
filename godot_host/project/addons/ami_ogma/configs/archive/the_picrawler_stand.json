{
  "metadata": {
    "name": "PiCrawler — Baseline (no learning)",
    "description": "Demo baseline.  IMU + joints proprioception, 8 Premotors, 12 servo channels.  Reward graded by chassis height via events.hit.  But mc_episode_period=0 in continuous mode means events.episode_end is never published — Premotor MC REINFORCE never finalises, weights stay frozen at init.  Result: motor babbling, no convergence to standing.  Use this to demonstrate the 'broken state' before the wiring/stability fix.",
    "env_target": "picrawler",
    "phase_tag": "Stage A1 — baseline (mc_period=0, stability=0)",
    "episode_length": 6000,
    "mc_episode_period": 0,
    "stability_gain":    0.0
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001,
        "wall_stuck_da_drain": 0.0,
        "wall_stuck_ht_drain": 0.0
      }
    },
    {
      "id": "epm_imu",
      "type": "EPM",
      "params": {
        "modality_group": "vestibular",
        "modality_name": "imu",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.imu",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_joints",
      "type": "EPM",
      "params": {
        "modality_group": "proprio",
        "modality_name": "joints",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.joints",
        "projection_dim": 48,
        "proprio_state_dims": 12,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "voter_0",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.",
        "trust_epsilon": 0.05,
        "group_balance": true,
        "priority_group": "vestibular"
      }
    },
    {
      "id": "descend",
      "type": "DescendingPredictor",
      "params": {
        "consensus_topic": "consensus.0",
        "targets": [
          "reality.vestibular.imu",
          "reality.proprio.joints"
        ],
        "update_method": "sgd",
        "learning_rate": 0.005
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": ["alive"],
        "channel_kinds": ["alive_pulse"],
        "setpoints": [1.0],
        "urgency_normalizers": [1.0],
        "channel_input_topics": ["events.hit"],
        "alive_pulse_decay_per_tick": 0.005,
        "alive_pulse_replenish_per_event": 0.5
      }
    },
    {
      "id": "premotor_fl_hip1",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "action_output_topic": "action.fl_hip1",
        "update_alpha_threshold": 0.0, "master_seed": 101,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true
      }
    },
    {
      "id": "premotor_fr_hip1",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "action_output_topic": "action.fr_hip1",
        "update_alpha_threshold": 0.0, "master_seed": 201,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true
      }
    },
    {
      "id": "premotor_rl_hip1",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "action_output_topic": "action.rl_hip1",
        "update_alpha_threshold": 0.0, "master_seed": 301,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true
      }
    },
    {
      "id": "premotor_rr_hip1",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "action_output_topic": "action.rr_hip1",
        "update_alpha_threshold": 0.0, "master_seed": 401,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true
      }
    },
    {
      "id": "premotor_fl_pitch",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.fl_hip2",
        "output_topic_right": "action.fl_knee",
        "update_alpha_threshold": 0.0, "master_seed": 102,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "premotor_fr_pitch",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.fr_hip2",
        "output_topic_right": "action.fr_knee",
        "update_alpha_threshold": 0.0, "master_seed": 202,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "premotor_rl_pitch",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.rl_hip2",
        "output_topic_right": "action.rl_knee",
        "update_alpha_threshold": 0.0, "master_seed": 302,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    },
    {
      "id": "premotor_rr_pitch",
      "type": "Premotor",
      "params": {
        "level": 0, "n_intents": 5, "accel_min": -1.0, "accel_max": 1.0,
        "gain": 1.0, "learning_rate": 0.05,
        "temperature_base": 1.0, "temperature_da_gain": 0.5,
        "sample_action": true, "use_weighted_accel": true,
        "output_topic_left":  "action.rr_hip2",
        "output_topic_right": "action.rr_knee",
        "update_alpha_threshold": 0.0, "master_seed": 402,
        "pathway_temp_gain": 1.0, "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
        "lr_bc": 0.0, "bc_alpha_weighting": false, "bc_weight_decay": 0.0,
        "mc_lr": 0.05, "mc_gamma": 0.99,
        "advantage_normalization": true, "advantage_window": 100, "mc_reinforce": true,
        "bilateral_table": "[[-1,-1],[-0.5,-0.5],[0,0],[0.5,0.5],[1,1]]"
      }
    }
  ],
  "edges": []
}
