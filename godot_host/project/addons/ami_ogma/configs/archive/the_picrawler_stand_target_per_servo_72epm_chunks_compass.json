{
  "metadata": {
    "name": "PiCrawler \u2014 7.2-EPM per-leg chunks + Compass (Fractal JEPA + heading anchor)",
    "description": "Phase 7.2-EPM per-leg chunk pipeline + epm_compass.  Combines the Fractal JEPA per-leg chunks (4 EPMs / 4 SeqGNGs / 4 MotorRep / 4 ActionDecoder) with the world-frame heading channel from the compass variant.  Once chunks crystallise around recurring (per-leg-consensus + heading) co-occurrences, the brain has heading-conditioned gait primitives.\n\nCrystallisation uses the v7.2-EPM per-position EMA accumulator (commit 17d0722) so chunks no longer solidify on single-hit flukes \u2014 they wait for patterns to recur across multiple events.hit firings.  Per-leg ActionDecoder unpacks combined intents into IntentToken.indices via radix encoding; the 12 Premotors each read their assigned channel.\n\nTest target: walking emergence via heading-anchored gait chunks.",
    "env_target": "picrawler",
    "phase_tag": "v6.17b + 7.2-EPM per-leg chunks + compass",
    "derived_from_manifest": true,
    "episode_length": 6000,
    "mc_episode_period": 1500,
    "stability_gain": 0.05,
    "stability_y_norm": 0.5,
    "stability_speed": 0.05,
    "reward_shape": "trapezoid",
    "target_height": 0.085,
    "height_penalty_grace": 0.02,
    "height_penalty_scale": 0.03,
    "height_penalty_gain": 0.05,
    "leg_symmetry": "lr_pairs"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
