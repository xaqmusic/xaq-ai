{
  "metadata": {
    "name": "Cell \u2014 heading-follower + PILLARS + TRANSPARENT scent (UI: slide-vs-wedge)",
    "description": "UI observation config: the validated heading-follower with pillars ON (obstacle_density=0.18) and TRANSPARENT scent (obstacle_scent_attenuation=1.0 = true diffusion, scent flows around pillars). Compare to the_cell_corridor_turn_heading with pillars toggled on (occludable scent, atten 0.30): occludable corrupts the bearing (corr 0.55) \u2192 flail; transparent restores corr 1.0 \u2192 the bug heads straight to food but then WEDGES dead-on against the pillar (the remaining physical-obstacle problem = needs obstacle perception/routing, NOT a scent fix).",
    "env_target": "cell",
    "phase_tag": "6.9.corridor.turn.heading.transp",
    "reflex_modular": true,
    "body_model": "bidirectional_paddler",
    "motor_baseline_beat": false,
    "motor_energy": false,
    "corridor": true,
    "corridor_distance": 4.0,
    "corridor_bearing_max": 45.0,
    "nutrients": 1,
    "energy_drain": 0.0,
    "scent_sigma": 6.0,
    "room_size": 24.0,
    "obstacle_density": 0.18,
    "terrain_amplitude": 0.0,
    "vision_green_gain": 0.0,
    "food_respawn": true,
    "corridor_respawn_far": true,
    "obstacle_scent_attenuation": 1.0
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "scent_compass",
      "type": "ScentCompass",
      "params": {
        "input_topic": "reality.proprio.scent",
        "output_topic": "percept.scent_compass",
        "nostril_count": 8,
        "emit_proximity": true,
        "proximity_gain": 0.5,
        "normalize_direction": true,
        "min_signal": 0.02
      }
    },
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001,
        "scent_da_rate": 0.5,
        "green_da_rate": 0.0
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": [
          "energy",
          "scent_proximity"
        ],
        "channel_kinds": [
          "energy",
          "proprio_passive"
        ],
        "setpoints": [
          0.8,
          1.0
        ],
        "urgency_normalizers": [
          1.0,
          1.0
        ],
        "channel_input_topics": [
          "reality.proprio.energy",
          "reality.proprio.scent_max"
        ],
        "energy_drain_per_tick": 0.0,
        "energy_replenish_per_hit": 0.4
      }
    },
    {
      "id": "heading_controller",
      "type": "HeadingController",
      "params": {
        "input_topic": "percept.scent_compass",
        "cx_index": 0,
        "cy_index": 1,
        "steer_output_topic": "cog.steer",
        "thrust_output_topic": "cog.thrust",
        "_comment": "learned heading-follower: desired heading = scent up-gradient bearing; gain self-adapts to the body's turn response (no hand-set P-gain).",
        "turn_fraction": 2.5
      }
    },
    {
      "id": "motor_bus",
      "type": "MotorBus",
      "params": {
        "influencer_names": [
          "cog"
        ],
        "kinds": [
          "steer_thrust"
        ],
        "topics_a": [
          "cog.steer"
        ],
        "topics_b": [
          "cog.thrust"
        ],
        "input_scale": [
          4.0
        ],
        "gains": [
          1.0
        ],
        "limit": 4.0,
        "active_window": 2,
        "output_left": "action.left",
        "output_right": "action.right"
      }
    }
  ],
  "edges": []
}