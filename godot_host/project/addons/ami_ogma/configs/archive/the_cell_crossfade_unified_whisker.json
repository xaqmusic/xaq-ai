{
  "metadata": {
    "name": "Cell \u2014 bilateral crossfade (UNIFIED whisker, A/B baseline)",
    "description": "A/B baseline for the 6.6.M bilateral-whisker-perception split. Same as the_cell_crossfade.json before commit ffcdb65: single voter_whisker fuses all 6 whiskers symmetrically. Compare against the post-split config (current the_cell_crossfade.json) to measure perception-bilaterality lift.",
    "env_target": "cell",
    "phase_tag": "6.6.M.baseline",
    "reflex_modular": true,
    "body_model": "differential_paddler"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "scent_da_rate": 0.25,
        "travel_da_rate": 0.02,
        "whisker_ht_rate": 0.02,
        "hunger_ht_rate": 0.01,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001
      }
    },
    {
      "id": "epm_imu",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "imu",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.imu",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_scent",
      "type": "EPM",
      "params": {
        "modality_group": "proprio",
        "modality_name": "scent",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.scent",
        "projection_dim": 32,
        "proprio_state_dims": 8,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_0",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_0",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_0",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_1",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
