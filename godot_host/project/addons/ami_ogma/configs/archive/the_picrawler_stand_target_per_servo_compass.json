{
  "metadata": {
    "name": "PiCrawler — Per-Servo + Compass EPM (baseline variant)",
    "description": "6.17b 12-Premotor baseline + epm_compass — adds a world-frame heading EPM (modality_group=compass, modality_name=global) that subscribes to reality.proprio.compass (2-D sin/cos yaw published by the body).  Projection_dim=48 so it joins epm_joints in voter_0 fusion (epm_imu at projection_dim=32 stays silently dim-skipped, same as the 6.17b baseline; isolating the compass contribution rather than also fixing IMU).\n\nGoal: give the brain a stable world-frame front reference so future heading-conditioned gait chunks can crystallise.  No reward shaping — compass only enters as perceptual context (per [[feedback_no_tuning]] and the whisker-bonus Goodhart lesson).\n\nObserved-via-UI variant.  No chunks yet; that's the next rung once temporal-EMA crystallisation lands.",
    "env_target": "picrawler",
    "phase_tag": "v6.17b + compass",
    "derived_from_manifest": true,
    "episode_length": 6000,
    "mc_episode_period": 1500,
    "stability_gain": 0.05,
    "stability_y_norm": 0.5,
    "stability_speed": 0.05,
    "reward_shape": "trapezoid",
    "target_height": 0.085,
    "height_penalty_grace": 0.02,
    "height_penalty_scale": 0.03,
    "height_penalty_gain": 0.05,
    "leg_symmetry": "lr_pairs"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001,
        "wall_stuck_da_drain": 0.0,
        "wall_stuck_ht_drain": 0.0
      }
    },
    {
      "id": "epm_imu",
      "type": "EPM",
      "params": {
        "modality_group": "vestibular",
        "modality_name": "imu",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.imu",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_joints",
      "type": "EPM",
      "params": {
        "modality_group": "proprio",
        "modality_name": "joints",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.joints",
        "projection_dim": 48,
        "proprio_state_dims": 12,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_compass",
      "type": "EPM",
      "params": {
        "modality_group": "compass",
        "modality_name": "global",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.compass",
        "projection_dim": 48,
        "proprio_state_dims": 2,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "voter_0",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.",
        "trust_epsilon": 0.05,
        "group_balance": true,
        "priority_group": "vestibular"
      }
    },
    {
      "id": "descend",
      "type": "DescendingPredictor",
      "params": {
        "consensus_topic": "consensus.0",
        "targets": [
          "reality.vestibular.imu",
          "reality.proprio.joints"
        ],
        "update_method": "sgd",
        "learning_rate": 0.005
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": [
          "alive"
        ],
        "channel_kinds": [
          "alive_pulse"
        ],
        "setpoints": [
          1.0
        ],
        "urgency_normalizers": [
          1.0
        ],
        "channel_input_topics": [
          "events.hit"
        ],
        "alive_pulse_decay_per_tick": 0.005,
        "alive_pulse_replenish_per_event": 0.5
      }
    },
    {
      "id": "premotor_fl_hip1",
      "type": "Premotor",
      "params": {
        "level": 0,
        "n_intents": 5,
        "accel_min": -1.0,
