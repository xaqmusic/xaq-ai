{
  "metadata": {
    "name": "Cell \u2014 Premotor (graded policy)",
    "description": "Phase 6.5.25 A/B variant: replaces ActionDecoder (3-bin EFE argmax) with Premotor (5-intent softmax + Hebbian reward learning).  Tests whether graded policy representation beats discrete EFE argmax for navigation, in response to Phase 6.5.22 attribution showing the brain's net contribution at full ActionDecoder weight was ~zero.  Chunks + exploration remain silent in this first cut (no ActionGate yet); compare to derivation-aligned config which keeps ActionDecoder.",
    "env_target": "cell",
    "phase_tag": "6.5.25"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "scent_da_rate": 0.25,
        "travel_da_rate": 0.02,
        "whisker_ht_rate": 0.02,
        "hunger_ht_rate": 0.01,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001
      }
    },
    {
      "id": "epm_imu",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "imu",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.imu",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_scent",
      "type": "EPM",
      "params": {
        "modality_group": "proprio",
        "modality_name": "scent",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.scent",
        "projection_dim": 32,
        "proprio_state_dims": 8,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_0",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_0",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_0",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_1",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_1",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_1",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_2",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_2",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_2",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_3",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_3",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_3",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_4",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_4",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_4",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_whisker_5",
      "type": "EPM",
      "params": {
        "modality_group": "whisker",
        "modality_name": "whisker_5",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.whisker_5",
        "projection_dim": 16,
        "proprio_state_dims": 1,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_terrain",
      "type": "EPM",
      "params": {
        "modality_group": "kinematic",
        "modality_name": "terrain",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.terrain",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_color",
      "type": "EPM",
      "params": {
        "modality_group": "video",
        "modality_name": "color",
        "encoder_kind": "jl",
        "input_topic": "host.video.color",
        "projection_dim": 64,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "subtract_descending_prediction": false
      }
    },
    {
      "id": "descend",
      "type": "DescendingPredictor",
      "params": {
        "consensus_topic": "consensus.0",
        "targets": [
          "reality.kinematic.imu",
          "reality.proprio.scent",
          "reality.whisker.whisker_0",
          "reality.whisker.whisker_1",
          "reality.whisker.whisker_2",
          "reality.whisker.whisker_3",
          "reality.whisker.whisker_4",
          "reality.whisker.whisker_5",
          "reality.kinematic.terrain"
        ]
      }
    },
    {
      "id": "seq_consensus",
      "type": "SequenceGNG",
      "params": {
        "source_topic": "consensus.0",
        "source_kind": "winner",
        "window_size": 5,
        "projection_dim": 64
      }
    },
    {
      "id": "seq_action",
      "type": "SequenceGNG",
      "params": {
        "source_topic": "action.out",
        "source_kind": "action",
        "window_size": 5,
        "projection_dim": 64,
        "context_topic": "sequence.motif.consensus.0"
      }
    },
    {
      "id": "repertoire",
      "type": "MotorRepertoire",
      "params": {
        "max_chunks": 64,
        "chunk_max_ticks": 20,
        "crystallization_min_observations": 8,
        "crystallization_min_drive_delta": 0.03,
        "crystallization_drive_window_ticks": 60
      }
    },
    {
      "id": "voter_whisker",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.whisker.",
        "trust_epsilon": 0.05,
        "group_balance": false,
        "publish_consensus": false,
        "publish_as_reality_topic": "reality.fused.whisker"
      }
    },
    {
      "id": "voter_0",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.",
        "input_exclude": "reality.whisker.",
        "trust_epsilon": 0.05,
        "group_balance": true,
        "priority_group": "kinematic"
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": [
          "energy",
          "novelty_satiation",
          "scent_proximity"
        ],
        "channel_kinds": [
          "energy",
          "novelty_ema",
          "proprio_passive"
        ],
        "setpoints": [
          0.8,
          0.5,
          1.0
        ],
        "urgency_normalizers": [
          1.0,
          0.5,
          1.0
        ],
        "channel_input_topics": [
          "reality.proprio.energy",
          "consensus.0",
          "reality.proprio.scent_max"
        ],
        "energy_drain_per_tick": 0.0005,
        "energy_replenish_per_hit": 0.5,
        "novelty_satiation_alpha": 0.001
      }
    },
    {
      "id": "premotor",
      "type": "Premotor",
      "params": {
        "level": 0,
        "n_intents": 5,
        "accel_min": -4.0,
        "accel_max": 4.0,
        "gain": 1.0,
        "learning_rate": 0.05,
        "temperature_base": 1.0,
        "temperature_da_gain": 0.5,
        "sample_action": true,
        "use_weighted_accel": true,
        "master_seed": 0
      }
    },
    {
      "id": "kinesis",
      "type": "HomeokineticExploration",
      "params": {
        "window_ticks": 120,
        "long_window_ticks": 480,
        "change_ema_alpha": 0.002,
        "anomaly_factor": 0.5,
        "chunk_match_eps": 0.01,
        "episode_ticks": 60,
        "cooldown_ticks": 30,
        "accel_jitter": 1.0
      }
    }
  ],
  "edges": []
}
