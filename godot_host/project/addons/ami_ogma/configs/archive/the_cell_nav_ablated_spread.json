{
  "metadata": {
    "name": "Cell \u2014 nav (ABLATED floor) cog_steer_gain=0 +SPREAD",
    "description": "Ignition ablation control: identical graph to fast_bundle but the EFE actor's motor authority is CUT (cog_steer_gain=0). The brain still ticks; only its steer reaches nothing. Body = pure homeokinetic swim. This is the brain-OFF floor for the ignition gate \u2014 brain-on must beat THIS to claim the brain forages.",
    "env_target": "cell",
    "phase_tag": "6.9.nav.ablated",
    "reflex_modular": true,
    "body_model": "bidirectional_paddler",
    "motor_baseline_beat": true,
    "motor_energy": true,
    "nutrients": 12,
    "energy_drain": 0.012,
    "scent_sigma": 6.0,
    "room_size": 24.0,
    "obstacle_density": 0.0,
    "terrain_amplitude": 0.0,
    "vision_green_gain": 0.85,
    "food_respawn": false,
    "nutrient_center_sigma": 8.0
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
