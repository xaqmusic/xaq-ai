{
  "metadata": {
    "name": "PiCrawler \u2014 LR-symmetric Premotors (current default)",
    "description": "Launcher default after Stage B win.  Identical to the_picrawler_stand_target.json EXCEPT leg_symmetry=lr_pairs.  At each mc_episode_period boundary the body averages W/b/E across FL\u2194FR and RL\u2194RR Premotor pairs (hip1 + pitch).  n=20 paired-seed A/B (2026-05-19) showed \u221269% falls, \u221260% high-tilt time, +152% longest continuous stand, +32% max walking distance \u2014 all p<0.01.  Front-vs-rear asymmetry preserved.  Body-side sync hook only; no module param diff.",
    "env_target": "picrawler",
    "phase_tag": "v6 default \u2014 LR-symmetric",
    "derived_from_manifest": true,
    "episode_length": 6000,
    "mc_episode_period": 1500,
    "stability_gain": 0.05,
    "stability_y_norm": 0.5,
    "stability_speed": 0.05,
    "reward_shape": "trapezoid",
    "target_height": 0.085,
    "height_penalty_grace": 0.02,
    "height_penalty_scale": 0.03,
    "height_penalty_gain": 0.05,
    "leg_symmetry": "lr_pairs"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001,
        "wall_stuck_da_drain": 0.0,
        "wall_stuck_ht_drain": 0.0
      }
    },
    {
      "id": "epm_imu",
      "type": "EPM",
      "params": {
        "modality_group": "vestibular",
        "modality_name": "imu",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.imu",
        "projection_dim": 32,
        "proprio_state_dims": 4,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "epm_joints",
      "type": "EPM",
      "params": {
        "modality_group": "proprio",
        "modality_name": "joints",
        "encoder_kind": "rbf",
        "input_topic": "reality.proprio.joints",
        "projection_dim": 48,
        "proprio_state_dims": 12,
        "baking_threshold": 50,
        "min_insertion_error": 0.02,
        "predicted_pathway_steps": 3,
        "subtract_descending_prediction": true
      }
    },
    {
      "id": "voter_0",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.",
        "trust_epsilon": 0.05,
        "group_balance": true,
        "priority_group": "vestibular"
      }
    },
    {
      "id": "descend",
      "type": "DescendingPredictor",
      "params": {
        "consensus_topic": "consensus.0",
        "targets": [
          "reality.vestibular.imu",
          "reality.proprio.joints"
        ],
        "update_method": "sgd",
        "learning_rate": 0.005
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": [
          "alive"
        ],
        "channel_kinds": [
          "alive_pulse"
        ],
        "setpoints": [
          1.0
        ],
        "urgency_normalizers": [
          1.0
        ],
        "channel_input_topics": [
          "events.hit"
        ],
        "alive_pulse_decay_per_tick": 0.005,
        "alive_pulse_replenish_per_event": 0.5
      }
    },
    {
      "id": "premotor_fl_hip1",
      "type": "Premotor",
      "params": {
        "level": 0,
        "n_intents": 5,
        "accel_min": -1.0,
        "accel_max": 1.0,
        "gain": 1.0,
        "learning_rate": 0.05,
        "temperature_base": 1.0,
        "temperature_da_gain": 0.5,
        "sample_action": true,
        "use_weighted_accel": true,
        "action_output_topic": "action.fl_hip1",
        "update_alpha_threshold": 0.0,
        "master_seed": 101,
        "pathway_temp_gain": 1.0,
        "state_visit_alpha": 0.05,
        "output_noise_amplitude": 0.0,
