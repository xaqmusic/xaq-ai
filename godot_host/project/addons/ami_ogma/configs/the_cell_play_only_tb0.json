          1.0,
          1.0,
          1.0
        ],
        "projection_dim": 48,
        "min_insertion_error": 0.1,
        "max_nodes": 40,
        "mitosis_enabled": false,
        "baking_threshold": 5,
        "process_every_n_ticks": 1,
        "subtract_descending_prediction": false
      }
    },
    {
      "type": "PlayLoop",
      "id": "play",
      "params": {
        "place_topic": "reality.cognitive.place",
        "heading_topic": "reality.proprio.heading",
        "vel_topic": "reality.proprio.vel_ego",
        "eat_topic": "events.eat",
        "output_topic": "percept.play_bearing",
        "play_value_topic": "reality.cognitive.play_value",
        "pi_cell_size": 20.0,
        "wander_stall_ticks": 30
      }
    },
    {
      "id": "heading_controller_play",
      "type": "HeadingController",
      "params": {
        "input_topic": "percept.play_bearing",
        "cx_index": 0,
        "cy_index": 1,
        "steer_output_topic": "cogp.steer",
        "thrust_output_topic": "cogp.thrust",
        "turn_fraction": 2.5,
        "learn_advance": true,
        "vel_topic": "reality.proprio.vel_ego",
        "n_err_bins": 4,
        "n_thrust_acts": 3,
        "advance_lr": 0.1,
        "ucb_c": 0.4,
        "effort_cost": 0.15,
        "forward_only": false,
        "reverse_brake_only": true,
        "authority_topic": "motor.bus.authority.play",
        "advance_homeokinetic": true,
        "gain_min": 1.0,
        "gain_max": 3.0
      }
    },
    {
      "id": "whisker_reflex",
      "type": "WhiskerSteerReflex",
      "params": {
        "whisker_topic_prefix": "reality.proprio.whisker_",
        "output_topic_left": "whisker.left",
        "output_topic_right": "whisker.right",
        "threshold": 0.15,
        "reverse_strength": 4.0,
        "refractory_ticks": 45,
        "pulse_ticks": 6
      }
    },
    {
      "id": "stuck_reflex",
      "type": "StuckEscapeReflex",
      "params": {
        "imu_topic": "reality.proprio.imu",
        "vx_index": 2,
        "vz_index": 3,
        "severity_threshold": 0.6,
        "window_ticks": 15,
        "refractory_ticks": 120,
        "enable_pulse": true,
        "output_topic_left": "stuck.left",
        "output_topic_right": "stuck.right",
        "pulse_ticks": 60,
        "pulse_rotation": 4.0,
        "efference_topic": "reality.proprio.motor_efference",
        "intent_floor": 0.1
      }
    },
    {
      "id": "motor_bus",
      "type": "MotorBus",
      "params": {
        "influencer_names": [
          "play",
          "whisker",
          "stuck"
        ],
        "kinds": [
          "steer_thrust",
          "lr",
          "lr"
        ],
        "topics_a": [
          "cogp.steer",
          "whisker.left",
          "stuck.left"
        ],
        "topics_b": [
          "cogp.thrust",
          "whisker.right",
          "stuck.right"
        ],
        "input_scale": [
          4.0,
          4.0,
          4.0
        ],
        "gains": [
          0.75,
          4.0,
          4.0
        ],
        "limit": 4.0,
        "active_window": 2,
        "authority_prefix": "motor.bus.authority.",
        "output_left": "action.left",
        "output_right": "action.right",
        "proportional_mix": true,
        "turn_brake": 0.0,
        "labels": [
          "play",
          "whisker",
          "stuck"
        ]
      }
    }
  ],
