{
  "metadata": {
    "name": "Cell \u2014 PLAY ISOLATION (PlayLoop GROW, no arbiter) + turn_brake=0",
    "description": "The play strange-loop ALONE: cylinder -> epm_place -> PlayLoop -> heading_controller_play -> MotorBus (single cog + safety reflexes) -> body. NO arbiter, NO klino/planner, NO vision-EPM/neuro. Open 32m arena, NO food (pure exploration). Isolation gate: does coverage (odometry cells visited / trajectory spread) RISE over time, and does wander actually TRAVEL (net displacement per tumble cycle, not spin-in-place)? Never abstains. Floor control: play shuffle/learning-off = random walk. Exact PlayLoop block from the_cell_arbiter_quad_play.",
    "env_target": "cell",
    "phase_tag": "loop_isolation.play",
    "reflex_modular": true,
    "body_model": "bidirectional_paddler",
    "motor_baseline_beat": false,
    "motor_energy": false,
    "maze": true,
    "maze_layout": "open",
    "scent_falloff_radius": 12.0,
    "nutrients": 1,
    "publish_scent_ring": false,
    "energy_drain": 0.0,
    "room_size": 32.0,
    "obstacle_density": 0.0,
    "terrain_amplitude": 0.0,
    "vision_green_gain": 0.0,
    "food_respawn": false,
    "food_positions": [
      [
        0.4,
        0.4
      ]
    ],
    "zone_colors": true
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "cylinder",
      "type": "CylinderBuilder",
      "params": {
        "frame_topic": "host.video.color",
        "heading_topic": "reality.proprio.heading",
        "active_topic": "",
