{
  "metadata": {
    "name": "CartPole \u2014 no-EPM ablation",
    "description": "Cell-state EPM removed; control for the EPM-load-bearing claim. Used in Phase 6.5.2 validation arm-C.",
    "env_target": "cartpole",
    "phase_tag": "6.5.2"
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "event_coupled_da": true,
        "event_coupled_ht": true
      }
    },
    {
      "id": "rollout",
      "type": "GNGRollout",
      "params": {
        "K_default": 16,
        "M_default": 4
      }
    },
    {
      "id": "seq_consensus",
      "type": "SequenceGNG",
      "params": {
        "source_topic": "consensus.0",
        "source_kind": "winner",
        "window_size": 5,
        "projection_dim": 64
      }
    },
    {
      "id": "seq_action",
      "type": "SequenceGNG",
      "params": {
        "source_topic": "action.out",
        "source_kind": "action",
        "window_size": 5,
        "projection_dim": 64
      }
    },
    {
      "id": "repertoire",
      "type": "MotorRepertoire",
      "params": {
        "max_chunks": 64,
        "chunk_max_ticks": 20,
        "crystallization_min_observations": 8,
        "crystallization_min_drive_delta": 0.03,
        "crystallization_drive_window_ticks": 60
      }
    },
    {
      "id": "voter_0",
      "type": "LateralVoter",
      "params": {
        "level": 0,
        "input_pattern": "reality.",
        "trust_epsilon": 0.05,
        "group_balance": false,
        "priority_group": "kinematic"
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": [
          "alive"
        ],
        "channel_kinds": [
          "alive_pulse"
        ],
        "setpoints": [
          1.0
        ],
        "urgency_normalizers": [
          1.0
        ],
        "channel_input_topics": [
          "events.alive"
        ],
        "alive_pulse_decay_per_tick": 0.005,
        "alive_pulse_replenish_per_event": 0.5
      }
    },
    {
      "id": "action_decoder",
      "type": "ActionDecoder",
      "params": {
        "consensus_level": 0,
        "proprio_topic": "reality.kinematic.cart_state",
        "action_bins": 2,
        "accel_min": -4.0,
        "accel_max": 4.0,
        "pragmatic_gain": 10.0,
        "epistemic_gain": 2.0,
        "td_lambda": 0.7,
        "td_gamma": 0.95,
        "urgency_exploit_threshold": 0.3,
        "urgency_exploit_bias": 4.0,
        "use_rollout": true,
        "use_chunks": true
      }
    },
    {
      "id": "kinesis",
      "type": "HomeokineticExploration",
      "params": {
        "window_ticks": 120,
        "long_window_ticks": 480,
        "change_ema_alpha": 0.002,
        "anomaly_factor": 0.5,
        "chunk_match_eps": 0.01,
        "episode_ticks": 60,
        "cooldown_ticks": 30,
        "accel_jitter": 1.0
      }
    }
  ],
  "edges": []
}
