{
  "metadata": {
    "name": "Cell \u2014 corridor TURN rig + BELIEF-carrying heading-follower (de-scaffold Stage 1a)",
    "description": "De-scaffold Stage 1a: insert a GoalBelief module (path integration \u2014 stores the goal direction in the WORLD frame via the bug's heading) between ScentCompass and the HeadingController, so a momentary scent occlusion no longer erases the heading. The controller follows the BELIEF (percept.goal_belief), not the raw instantaneous compass. GATE = occlusion-pillar arena: the belief planner keeps homing through occlusion while the belief-less reflex (the_cell_corridor_turn_heading) oscillates. Ablation: point the controller back at percept.scent_compass.",
    "env_target": "cell",
    "phase_tag": "6.9.corridor.turn.belief",
    "reflex_modular": true,
    "body_model": "bidirectional_paddler",
    "motor_baseline_beat": false,
    "motor_energy": false,
    "corridor": true,
    "corridor_distance": 4.0,
    "corridor_bearing_max": 45.0,
    "nutrients": 1,
    "energy_drain": 0.0,
    "scent_sigma": 6.0,
    "room_size": 24.0,
    "obstacle_density": 0.0,
    "terrain_amplitude": 0.0,
    "vision_green_gain": 0.0,
    "food_respawn": true,
    "corridor_respawn_far": true
  },
  "version": 1,
  "runtime": {
    "thread_pool": "per_instance",
    "num_threads": 0
  },
  "modules": [
    {
      "id": "scent_compass",
      "type": "ScentCompass",
      "params": {
        "input_topic": "reality.proprio.scent",
        "output_topic": "percept.scent_compass",
        "nostril_count": 8,
        "emit_proximity": true,
        "proximity_gain": 0.5,
        "normalize_direction": true,
        "min_signal": 0.02
      }
    },
    {
      "id": "goal_belief",
      "type": "GoalBelief",
      "params": {
        "scent_topic": "percept.scent_compass",
        "heading_topic": "reality.proprio.heading",
        "output_topic": "percept.goal_belief",
        "cx_index": 0,
        "cy_index": 1,
        "_comment": "persistent world-frame goal belief; bridges occlusion via path integration"
      }
    },
    {
      "id": "neuro",
      "type": "NeurochemState",
      "params": {
        "da_baseline": 0.2,
        "ht_baseline": 0.65,
        "da_decay": 0.88,
        "ht_decay": 0.93,
        "intrinsic_da_gain": 0.05,
        "event_coupled_da": true,
        "event_coupled_ht": true,
        "da_baseline_ema_alpha": 0.001,
        "scent_da_rate": 0.5,
        "green_da_rate": 0.0
      }
    },
    {
      "id": "drive",
      "type": "HomeostaticDrive",
      "params": {
        "channels": [
          "energy",
          "scent_proximity"
        ],
        "channel_kinds": [
          "energy",
          "proprio_passive"
        ],
        "setpoints": [
          0.8,
          1.0
        ],
        "urgency_normalizers": [
          1.0,
          1.0
        ],
        "channel_input_topics": [
          "reality.proprio.energy",
          "reality.proprio.scent_max"
        ],
        "energy_drain_per_tick": 0.0,
        "energy_replenish_per_hit": 0.4
      }
    },
    {
      "id": "heading_controller",
      "type": "HeadingController",
      "params": {
        "input_topic": "percept.goal_belief",
        "cx_index": 0,
        "cy_index": 1,
        "steer_output_topic": "cog.steer",
        "thrust_output_topic": "cog.thrust",
        "_comment": "learned heading-follower: desired heading = scent up-gradient bearing; gain self-adapts to the body's turn response (no hand-set P-gain).",
        "turn_fraction": 2.5,
        "gain_min": 1.0,
        "gain_max": 3.0
      }
    },
    {
      "id": "motor_bus",
      "type": "MotorBus",
      "params": {
        "influencer_names": [
          "cog"
        ],
        "kinds": [
          "steer_thrust"
        ],
        "topics_a": [
          "cog.steer"
        ],
        "topics_b": [
          "cog.thrust"
        ],
        "input_scale": [
          4.0
        ],
        "gains": [
          1.0
        ],
        "limit": 4.0,
        "active_window": 2,
        "output_left": "action.left",
        "output_right": "action.right"
      }
    }
  ],
  "edges": []
}