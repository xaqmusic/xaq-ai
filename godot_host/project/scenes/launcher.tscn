[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/launcher.gd" id="1"]

[node name="Launcher" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.08, 0.09, 0.12, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -300.0
offset_right = 360.0
offset_bottom = 300.0
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 28

[node name="V" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/V"]
layout_mode = 2
text = "xaq — Experiment Launcher"
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Margin/V"]
layout_mode = 2
text = "Reproduce experiments from the v4 development path. Select an environment + brain config, set a seed, and launch."
horizontal_alignment = 1
autowrap_mode = 2
theme_override_colors/font_color = Color(0.7, 0.75, 0.82, 1)

[node name="Sep1" type="HSeparator" parent="Margin/V"]
layout_mode = 2

