[node name="LegendLabel" type="Label" parent="V/H/PanelV"]
layout_mode = 2
text = "W (yellow):  current consensus / query
solid disk:  real node position (centroid C_k)
ring:        ghost position = effective distance after warp
gold:        nearest node by warped distance

The real map never changes. Only the effective metric does. That is geometry-as-memory."
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.70, 0.72, 0.78, 1)
