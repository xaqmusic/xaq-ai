theme_override_colors/font_color = Color(0.92, 0.93, 0.96, 1)

[node name="Subtitle" type="Label" parent="V"]
layout_mode = 2
text = "Real nodes don't move. Their EFFECTIVE positions (the rings around them) drift toward the query W as the system experiences them together. Click any node to add a co-occurrence event. The nearest node by warped distance — whose ring is closest to W — is highlighted gold."
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.70, 0.72, 0.78, 1)
autowrap_mode = 3

