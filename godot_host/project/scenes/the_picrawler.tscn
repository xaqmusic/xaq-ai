[node name="Sun" type="DirectionalLight3D" parent="."]
; DirectionalLight3D shines along local -Z.  Previous transform had
; basis.z=(0,-1,0) which made the light shine UP into the sky → floor
; got no direct illumination → no cast shadows.
; New transform: basis.z = (-0.354, 0.866, 0.354) so light shines
; (0.354, -0.866, -0.354) — 30° off vertical, slightly +X -Z, casts
; readable shadows under the body.
transform = Transform3D(0.707, 0.612, -0.354, 0, 0.501, 0.866, 0.707, -0.612, 0.354, 0, 8, 0)
light_energy = 1.2
shadow_enabled = true
shadow_bias = 0.02
directional_shadow_max_distance = 5.0

