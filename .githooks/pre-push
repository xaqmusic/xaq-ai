#!/usr/bin/env bash
# THE GATE.  A commit is local and rewritable; a push is not -- to a public remote it
# is irreversible, and the 2026-09-05 leak had to be fixed by rewriting published
# history.  So this checks BOTH:
#   (a) every line added by the commits being pushed  -- a secret added then removed is
#       still published if both commits go up;
#   (b) the tip tree itself -- a secret that predates this push is published by it too.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
zero='0000000000000000000000000000000000000000'
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # branch deletion

    if [ "$remote_sha" = "$zero" ]; then            # new branch: diff from what the remote already has
        base="$(git merge-base "$local_sha" $(git for-each-ref --format='%(objectname)' refs/remotes/ | head -50) 2>/dev/null | head -1 || true)"
        range="${base:+$base..}$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    added="$(git diff --unified=0 $range 2>/dev/null | grep '^+' | grep -v '^+++' || true)"
    msgs="$(git log --format='%B' $range 2>/dev/null || true)"
    if [ -n "$added$msgs" ] && ! printf '%s\n%s\n' "$added" "$msgs" | "$here/scan-identifiers.sh"; then
        echo "pre-push: in the commits being pushed ($range)" >&2
        status=1
    fi

    tree="$(git grep -I -h '' "$local_sha" -- . 2>/dev/null || true)"
    if [ -n "$tree" ] && ! printf '%s\n' "$tree" | "$here/scan-identifiers.sh"; then
        echo "pre-push: present in the tree at $local_sha (predates this push, but this push publishes it)" >&2
        status=1
    fi
done

if [ $status -ne 0 ]; then
    cat >&2 <<'MSG'

pre-push: refusing — a push to a public remote cannot be taken back.

  Replace the values with the documented placeholders (REPORTS.md).  If they are
  already in published history, rewriting is the only fix, so stop and check.

  Deliberate override: git push --no-verify
MSG
    exit 1
fi
exit 0
